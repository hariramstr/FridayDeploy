@model IReadOnlyList<ExceptionGroupViewModel>
@{
    ViewData["Title"] = "Exceptions";
}

<header class="page-header"><div><p class="eyebrow">Failure patterns</p><h1>Exceptions</h1></div></header>
<section class="panel">
    @if (Model.Count == 0)
    {
        <p class="muted">Nothing exploded today.</p>
    }
    else
    {
        <div class="stack-list">
        @foreach (var group in Model)
        {
            <a asp-action="Details" asp-route-id="@group.Id" class="exception-row">
                <span class="status @ExceptionStatusHelper.CssClass(group.Status)">@group.Status</span>
                <span class="mono">@group.SampleMessage</span>
                <strong>@group.OccurrenceCount&times;</strong>
                <span>@group.Application</span>
                <span class="muted">first @group.FirstSeenUtc.ToDisplayString()</span>
                <span class="muted">last @group.LastSeenUtc.ToDisplayString()</span>
            </a>
        }
        </div>
    }
</section>
