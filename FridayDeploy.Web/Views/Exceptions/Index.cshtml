@model IReadOnlyList<ExceptionSummaryViewModel>
@{
    ViewData["Title"] = "Exceptions";
}

<header class="page-header"><div><p class="eyebrow">Failure patterns</p><h1>Top Exceptions</h1></div></header>
<section class="panel">
    @if (Model.Count == 0)
    {
        <p class="muted">Nothing exploded today.</p>
    }
    else
    {
        <div class="stack-list">
        @foreach (var item in Model)
        {
            <a asp-controller="Logs" asp-action="Index" asp-route-Query="Exception~@item.Exception">
                <span class="mono">@item.Exception</span>
                <strong>@item.Count</strong>
                <span>@item.Application</span>
                <span class="muted">@item.LastSeenUtc.ToString("u")</span>
            </a>
        }
        </div>
    }
</section>
