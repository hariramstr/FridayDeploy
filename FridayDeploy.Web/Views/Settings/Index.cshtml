@model SettingsViewModel
@{
    ViewData["Title"] = "Settings";
}

<header class="page-header"><div><p class="eyebrow">Configuration</p><h1>Settings</h1></div></header>

@if (Model.Saved)
{
    <section class="panel alert-success-soft"><p>Settings saved. Theme and page size apply immediately; some values may need a page refresh.</p></section>
}

@if (Model.Truncated)
{
    <section class="panel alert-success-soft"><p>All log data cleared. API keys, applications, and settings were preserved.</p></section>
}

<form asp-action="Save" method="post" class="panel stack">
    <label for="retentionDays">Retention Days</label>
    <input id="retentionDays" class="fd-input" type="number" name="RetentionDays" value="@Model.RetentionDays" min="1" max="365" />

    <label for="refreshIntervalSeconds">Refresh Interval (seconds)</label>
    <input id="refreshIntervalSeconds" class="fd-input" type="number" name="RefreshIntervalSeconds" value="@Model.RefreshIntervalSeconds" min="5" max="3600" />

    <label for="pollingIntervalSeconds">Polling Interval (seconds)</label>
    <input id="pollingIntervalSeconds" class="fd-input" type="number" name="PollingIntervalSeconds" value="@Model.PollingIntervalSeconds" min="5" max="3600" />

    <label for="pageSize">Page Size</label>
    <input id="pageSize" class="fd-input" type="number" name="PageSize" value="@Model.PageSize" min="10" max="200" />

    <label for="theme">Theme</label>
    <select id="theme" class="fd-input" name="Theme">
        <option value="Dark" selected="@(Model.Theme == "Dark")">Dark</option>
        <option value="Light" selected="@(Model.Theme == "Light")">Light</option>
        <option value="System" selected="@(Model.Theme == "System")">System</option>
    </select>

    <label for="brandingName">Branding Name</label>
    <input id="brandingName" class="fd-input" name="BrandingName" value="@Model.BrandingName" placeholder="FridayDeploy" />

    <label for="adminUsername">Admin Username</label>
    <input id="adminUsername" class="fd-input" value="@Model.AdminUsername" disabled />

    <button class="primary-button" type="submit">Save settings</button>
</form>

<section class="panel">
    <h2>Danger Zone</h2>
    <p class="muted">Permanently deletes all logs, notes, bookmarks, and saved searches. API keys, registered applications, and these settings are kept — you won't need to re-create integrations.</p>
    <form asp-action="TruncateData" method="post" onsubmit="return confirm('Delete all logs, notes, bookmarks, and saved searches? API keys and applications are kept. This cannot be undone.');">
        <button class="ghost-button danger" type="submit">Clear all log data</button>
    </form>
</section>
